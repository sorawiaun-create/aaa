# ---- SPX proxy config ----
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ถูก gitignore ไม่ถูก push)
PORT=3000

# เครดิตจากหน้า "รหัสผู้ใช้งาน / Secret Key / รหัสบัญชี" ในเว็บ SPX
SPX_USER_ID=
SPX_SECRET_KEY=
SPX_ACCOUNT_ID=

# ค่าที่ต้องเอามาจาก "หน้าเอกสาร API" ของ SPX (ยังต้องยืนยัน)
SPX_BASE_URL=https://openapi.spx.co.th
SPX_COD_PATH=/api/v1/cod/order/list

# วิธีเซ็นลายเซ็น: hmac_sha256_hex | hmac_sha256_base64  (ปรับตามเอกสารจริง)
SPX_SIGN_METHOD=hmac_sha256_hex

# เปิด mock=1 เพื่อรันทดสอบด้วยข้อมูลจำลอง (ไม่ยิง SPX จริง)
SPX_MOCK=1
