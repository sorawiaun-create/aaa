# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่า (หรือ export ใน terminal ก็ได้)

# ============ จำเป็น: สมองของระบบ (Claude) ============
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ============ ไม่ใส่ก็ได้: เจนภาพ/วิดีโอจริง ============
# ค่าเริ่มต้น 'placeholder' (สร้างไฟล์ตัวอย่าง ไม่ต้องมี key)
# IMAGE_PROVIDER=replicate
# VIDEO_PROVIDER=replicate
# REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxx
# IMAGE_MODEL=black-forest-labs/flux-schnell
# VIDEO_MODEL=minimax/video-01

# ============ เผยแพร่อัตโนมัติ (โพสต์ขึ้นแพลตฟอร์ม) ============
# ค่าเริ่มต้น = โหมดซ้อม (dry-run) ไม่โพสต์จริง
# ตั้ง PUBLISH_LIVE=true เพื่อโพสต์จริง / AUTO_PUBLISH=true เพื่อโพสต์ทันทีหลังรันแคมเปญ
# PUBLISH_LIVE=true
# AUTO_PUBLISH=true

# --- Facebook Page (Meta Graph API) ---
# ต้องมี Facebook App + Page Access Token (สิทธิ์ pages_manage_posts)
# FB_PAGE_ID=1234567890
# FB_PAGE_TOKEN=EAAxxxxxxxx
# FB_API_VERSION=v21.0

# --- Instagram (Business/Creator ผูกกับ FB Page) ---
# IG ต้องดึงสื่อจาก URL สาธารณะ -> ตั้ง MEDIA_BASE_URL ให้ชี้โฟลเดอร์ assets ที่ host ออนไลน์
# IG_USER_ID=17841400000000000
# IG_TOKEN=EAAxxxxxxxx
# MEDIA_BASE_URL=https://your-domain.com/campaigns/xxx/assets

# --- TikTok (Content Posting API) ---
# ต้องมี access token ผ่าน scope video.publish และแอปผ่าน app review ของ TikTok
# TIKTOK_TOKEN=act.xxxxxxxx
