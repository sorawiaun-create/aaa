# TikTok Marketing API credentials
# Create an app at https://ads.tiktok.com/marketing_api/ and get these values.
# You can also fill them in from the Settings page in the app UI instead of here.

TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# TikTok Marketing API base URL (usually no need to change)
TIKTOK_API_BASE=https://business-api.tiktok.com/open_api/v1.3

# How often (in minutes) the automation scheduler evaluates rules. Default 15.
SCHEDULER_INTERVAL_MINUTES=15

# Set to "false" to disable the background scheduler entirely.
SCHEDULER_ENABLED=true
