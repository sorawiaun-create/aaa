{
  "manifest_version": 3,
  "name": "Chobtham GMV Max Controller",
  "version": "0.22.2",
  "description": "มอนิเตอร์และควบคุมแคมเปญ GMV Max อัตโนมัติ ผ่านหน้า ads.tiktok.com",
  "permissions": ["storage", "alarms", "scripting", "sidePanel", "cookies"],
  "host_permissions": [
    "https://ads.tiktok.com/*",
    "https://shop.tiktok.com/*",
    "https://api.telegram.org/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://ads.tiktok.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://ads.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://shop.tiktok.com/*"],
      "js": ["live-inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://shop.tiktok.com/*"],
      "js": ["live-content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "GMV Max Controller (เปิดแผงข้าง)"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {}
}
