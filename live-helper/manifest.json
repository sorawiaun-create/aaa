{
  "manifest_version": 3,
  "name": "ผู้ช่วยไลฟ์ TikTok — ปักหมุดอัตโนมัติ + AI ตอบคอมเมนต์",
  "version": "1.0.0",
  "description": "ปักหมุดสินค้าซ้ำอัตโนมัติทุก 30 วิ/1 นาที (ตั้งเองได้) และให้ Claude ช่วยตอบคอมเมนต์ในคอนโซล LIVE ของ TikTok Shop",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "ผู้ช่วยไลฟ์ TikTok",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://*.tiktok.com/*",
        "https://*.tiktokglobalshop.com/*"
      ],
      "js": ["src/core.js", "src/dom.js", "src/autopin.js", "src/chat.js", "src/panel.js"],
      "css": ["src/panel.css"],
      "run_at": "document_idle"
    }
  ]
}
