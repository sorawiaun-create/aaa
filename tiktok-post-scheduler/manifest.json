{
  "manifest_version": 3,
  "name": "TikTok Clip Scheduler (ปักตะกร้า)",
  "version": "0.2.5",
  "description": "จัดคิว + ตั้งเวลาทยอยโพสต์คลิปของช่องตัวเอง พร้อมปักตะกร้าสินค้า ผ่านหน้า tiktok.com",
  "permissions": ["storage", "unlimitedStorage", "alarms", "scripting", "sidePanel", "tabs", "notifications"],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://api.telegram.org/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content-upload.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TikTok Clip Scheduler (เปิดแผงข้าง)"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {}
}
