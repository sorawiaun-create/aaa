const DEFAULT_DATA = [];

// Colors for Charts
// Added specific color for Affiliate (Pink/Red)
const COLORS = ['#FF5722', '#000000', '#00C853', '#2196F3', '#FE2C55', '#FFC107', '#25F4EE', '#9C27B0'];

// --- Helper Functions ---
const formatCurrency = (amount) => {
  return new Intl.NumberFormat('th-TH', {
    style: 'currency',
    currency: 'THB',
    minimumFractionDigits: 2
  }).format(amount || 0);
};

const parseThaiDate = (dateStr) => {
  if (!dateStr) return '';
  const monthMap = {
    Jan: '01', Feb: '02', Mar: '03', Apr: '04', May: '05', Jun: '06',
    Jul: '07', Aug: '08', Sep: '09', Oct: '10', Nov: '11', Dec: '12',
    January: '01', February: '02', March: '03', April: '04', June: '06',
    July: '07', August: '08', September: '09', October: '10', November: '11', December: '12'
  };

  // Format: "Dec 12, 2025"
  const fmt1 = dateStr.match(/([A-Z][a-z]{2})\s+(\d{1,2}),\s+(\d{4})/);
  if (fmt1) {
    const [_, m, d, y] = fmt1;
    return `${d.padStart(2, '0')}/${monthMap[m] || '01'}/${y}`;
  }

  // Format: "01, December, 2025" (TikTok Ads)
  const fmt2 = dateStr.match(/(\d{1,2}),\s+([A-Z][a-z]+),\s+(\d{4})/);
  if (fmt2) {
    const [_, d, m, y] = fmt2;
    return `${d.padStart(2, '0')}/${monthMap[m] || '01'}/${y}`;
  }

  return dateStr;
};

// Extract "MM/YYYY" period key from a "DD/MM/YYYY" date string
const monthOf = (dateStr) => {
  if (!dateStr) return 'ไม่ระบุ';
  const parts = dateStr.split('/');
  if (parts.length === 3) return `${parts[1]}/${parts[2]}`;
  return 'ไม่ระบุ';
};

// Sortable value for a "MM/YYYY" period key
const monthSortValue = (m) => {
  if (!m || m === 'ไม่ระบุ') return 0;
  const [mm, yyyy] = m.split('/');
  return parseInt(yyyy, 10) * 100 + parseInt(mm, 10);
};

const formatPercent = (v) => `${(v || 0).toFixed(1)}%`;

// --- V4: Advanced Parsing Logic ---

const groupItemsByLine = (items) => {
  const sorted = [...items].sort((a, b) => {
    const yDiff = b.transform[5] - a.transform[5];
    if (Math.abs(yDiff) > 5) return yDiff; 
    return a.transform[4] - b.transform[4];
  });

  const lines = [];
  let currentLine = null;

  for (const item of sorted) {
    const str = item.str.trim();
    if (!str) continue;

    if (!currentLine || Math.abs(item.transform[5] - currentLine.y) > 5) {
      if (currentLine) lines.push(currentLine);
      currentLine = { y: item.transform[5], text: str, items: [item] };
    } else {
      currentLine.text += ' ' + str;
      currentLine.items.push(item);
    }
  }
  if (currentLine) lines.push(currentLine);
  return lines;
};

const extractFromLines = (lines, keywords, strategy = 'right-most') => {
  for (const line of lines) {
    if (keywords.some(k => line.text.toLowerCase().includes(k.toLowerCase()))) {
      const matches = line.text.matchAll(/B?([\d,]+\.\d{2})/g);
      const numbers = [];
      for (const m of matches) {
        numbers.push(parseFloat(m[1].replace(/,/g, '')));
      }

      if (numbers.length === 0) continue;

      if (strategy === 'right-most') {
        return numbers[numbers.length - 1];
      } else if (strategy === 'left-most') {
        return numbers[0];
      } else if (strategy === 'sum') {
        return numbers.reduce((a, b) => a + b, 0);
      }
    }
  }
  return 0;
};

// --- Platform Specific Extraction ---

const extractShopeeDataV4 = (lines, fullText, fileName) => {
  const idMatch = fullText.match(/TRSPEMKP\d+-\d+-\d+/);
  const id = idMatch ? idMatch[0] : `SHOPEE-${fileName}`;
  const dateMatch = fullText.match(/(\d{2}\/\d{2}\/\d{4})/);
  const date = dateMatch ? dateMatch[1] : 'Unknown';

  const ads = extractFromLines(lines, ['Paid ads', 'ค่าโฆษณา'], 'right-most');
  const comm = extractFromLines(lines, ['Commission fee', 'ค่าคอมมิชชั่น'], 'right-most');
  const trans = extractFromLines(lines, ['Transaction fee', 'ค่าธรรมเนียมการทำธุรกรรม'], 'right-most');
  const service = extractFromLines(lines, ['Service fee', 'ค่าบริการ'], 'right-most');
  const ams = extractFromLines(lines, ['AMS Pay-Per-Sales', 'AMS'], 'right-most');
  const infra = extractFromLines(lines, ['Platform Infrastructure', 'ค่าโครงสร้างพื้นฐาน'], 'right-most');
  
  let vat = extractFromLines(lines, ['ภาษีมูลค่าเพิ่ม 7%', 'VAT 7%'], 'right-most');
  let total = extractFromLines(lines, ['รวมเงินทั้งสิ้น', 'Included VAT'], 'right-most');
  
  if (!total) {
    const subtotal = ads + comm + trans + service + ams + infra;
    total = subtotal * 1.07;
    if (!vat) vat = subtotal * 0.07;
  }

  const whtMatch = fullText.match(/จำนวนเงิน\s*([\d,]+\.\d{2})\s*บาท\s*แทนผู้จ่ายเงินได้/);
  const wht = whtMatch ? parseFloat(whtMatch[1].replace(/,/g, '')) : 0;

  return {
    id, date, 
    ads, comm, trans, service, ams, infra, 
    growth: 0, affiliate: 0, logistics: 0,
    vat, wht, total,
    platform: 'shopee'
  };
};

const extractTikTokDataV4 = (lines, fullText, isCreditNote, fileName) => {
  let date = 'Unknown';
  const dateMatch = fullText.match(/(?:Receipt Date:|Invoice Date:|Invoice date:|Credit note date:)\s*([A-Za-z0-9,\s]+20\d{2})/);
  if (dateMatch) date = parseThaiDate(dateMatch[1]);

  let id = 'Unknown';
  const idMatch = fullText.match(/(?:Receipt Number:|Invoice number:|Invoice No\.|Credit note number:)\s*([A-Z0-9]+)/);
  if (idMatch) id = idMatch[1];

  const multiplier = isCreditNote ? -1 : 1;

  // TikTok Ads
  let ads = extractFromLines(lines, ['Advertising Fees'], 'right-most');

  // TikTok Affiliate (Creator commission)
  let affiliate = extractFromLines(lines, ['Creator commission'], 'right-most'); 

  // TikTok Shop Fees
  let comm = extractFromLines(lines, ['Tik Tok Shop commission fee', 'Commission fee'], 'left-most');
  let trans = extractFromLines(lines, ['Transaction fee'], 'left-most');
  let growth = extractFromLines(lines, ['Commerce Growth Fee'], 'left-most');
  let infra = extractFromLines(lines, ['Infrastructure Fee'], 'left-most');
  
  let vat = extractFromLines(lines, ['Total VAT 7%', 'Tax Amount (VAT)', 'Total VAT @'], 'right-most');
  let total = extractFromLines(lines, ['Total Amount', 'Total amount (including VAT)', 'Net payable amount', 'Total Amount Due'], 'right-most');

  let wht = 0;
  const whtMatch = fullText.match(/withheld tax.*?amounting to B?([0-9,]+\.[0-9]{2})/);
  if (whtMatch) {
      wht = parseFloat(whtMatch[1].replace(/,/g, ''));
  }

  // Auto-detect platform label for UI clarity
  let subPlatform = 'tiktok';
  if (ads > 0) subPlatform = 'tiktok_ads';
  if (affiliate > 0) subPlatform = 'tiktok_affiliate';

  return {
      id, date, 
      ads: ads * multiplier, 
      comm: comm * multiplier,
      trans: trans * multiplier,
      service: 0, 
      ams: 0, 
      infra: infra * multiplier,
      growth: growth * multiplier,
      affiliate: affiliate * multiplier,
      logistics: 0,
      vat: vat * multiplier,
      wht: wht * multiplier,
      total: total * multiplier,
      platform: 'tiktok',
      subPlatform
  };
};

const extractThaiHappyDataV4 = (lines, fullText, fileName) => {
    let date = 'Unknown';
    const dateMatch = fullText.match(/Receipt date:\s*([A-Z][a-z]{2}\s+\d{1,2},\s+\d{4})/);
    if (dateMatch) date = parseThaiDate(dateMatch[1]);

    let id = 'Unknown';
    const idMatch = fullText.match(/Receipt number:\s*(THJV\d+)/);
    if (idMatch) id = idMatch[1];

    let logistics = extractFromLines(lines, ['Logistics fee'], 'right-most');
    let total = extractFromLines(lines, ['Total Amount'], 'right-most');

    let wht = 0;
    const whtMatch = fullText.match(/withheld tax.*?amounting to B?([0-9,]+\.[0-9]{2})/);
    if (whtMatch) wht = parseFloat(whtMatch[1].replace(/,/g, ''));

    let vat = extractFromLines(lines, ['VAT 7%'], 'right-most');

    return {
        id, date,
        ads: 0, comm: 0, trans: 0, service: 0, ams: 0, infra: 0, growth: 0, affiliate: 0,
        logistics: logistics,
        vat, wht, total,
        platform: 'tiktok', // Mapped to TikTok group
        subPlatform: 'thai_happy'
    };
};

export default function Dashboard() {
  const [activeTab, setActiveTab] = useState('import');
  const [platformFilter, setPlatformFilter] = useState('all'); 
  const [data, setData] = useState(DEFAULT_DATA);
  const [isProcessing, setIsProcessing] = useState(false);
  const [progress, setProgress] = useState(0);
  const [processedCount, setProcessedCount] = useState(0);
  const [totalFiles, setTotalFiles] = useState(0);
  const [fileStatusList, setFileStatusList] = useState([]);
  // Revenue / COGS entered manually, keyed by `${platform}__${MM/YYYY}`
  const [revenueMap, setRevenueMap] = useState({});
  const abortRef = useRef(false);

  const REVENUE_KEY = 'shopee_tiktok_revenue_v1';

  // Load PDF.js
  useEffect(() => {
    const script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
    script.async = true;
    script.onload = () => {
      window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      console.log("PDF.js loaded");
    };
    document.body.appendChild(script);

    const savedData = localStorage.getItem('shopee_tiktok_dashboard_data_v43');
    if (savedData) {
      setData(JSON.parse(savedData));
      setActiveTab('overview');
    }

    const savedRevenue = localStorage.getItem(REVENUE_KEY);
    if (savedRevenue) {
      try { setRevenueMap(JSON.parse(savedRevenue)); } catch (e) { /* ignore corrupt */ }
    }
    return () => { document.body.removeChild(script); }
  }, []);

  const updateRevenue = (key, field, value) => {
    setRevenueMap(prev => {
      const entry = prev[key] || { revenue: 0, cogs: 0 };
      const next = { ...prev, [key]: { ...entry, [field]: parseFloat(value) || 0 } };
      localStorage.setItem(REVENUE_KEY, JSON.stringify(next));
      return next;
    });
  };

  const saveData = () => {
    localStorage.setItem('shopee_tiktok_dashboard_data_v43', JSON.stringify(data));
    localStorage.setItem(REVENUE_KEY, JSON.stringify(revenueMap));
    alert('บันทึกข้อมูลเรียบร้อยแล้ว');
  };

  const clearData = () => {
    if (window.confirm('คุณแน่ใจหรือไม่ที่จะล้างข้อมูลทั้งหมด?')) {
      setData([]);
      setFileStatusList([]);
      setRevenueMap({});
      localStorage.removeItem('shopee_tiktok_dashboard_data_v43');
      localStorage.removeItem(REVENUE_KEY);
    }
  };

  const handleStop = () => {
      abortRef.current = true;
      setIsProcessing(false);
  };

  const handleFileUpload = async (event) => {
    const files = Array.from(event.target.files);
    if (files.length === 0) return;

    if (!window.pdfjsLib) {
      alert("ระบบอ่านไฟล์ยังโหลดไม่เสร็จ กรุณารอสักครู่...");
      return;
    }

    abortRef.current = false;
    setIsProcessing(true);
    setFileStatusList([]); 
    setTotalFiles(files.length);
    setProcessedCount(0);
    setProgress(0);
    
    const BATCH_SIZE = 10;
    let currentBatchData = [];
    let currentStatusList = [];
    
    try {
        for (let i = 0; i < files.length; i += BATCH_SIZE) {
            if (abortRef.current) break;

            const batch = files.slice(i, i + BATCH_SIZE);
            
            const batchResults = await Promise.all(batch.map(async (file) => {
                try {
                    const arrayBuffer = await file.arrayBuffer();
                    const pdf = await window.pdfjsLib.getDocument({ data: arrayBuffer }).promise;
                    
                    let fullText = '';
                    let allItems = [];
                    const maxPages = Math.min(pdf.numPages, 2); 

                    for (let p = 1; p <= maxPages; p++) {
                        const page = await pdf.getPage(p);
                        const textContent = await page.getTextContent();
                        allItems = [...allItems, ...textContent.items]; 
                        fullText += textContent.items.map(item => item.str).join(' ') + '\n';
                        page.cleanup();
                    }
                    pdf.destroy(); 

                    const lines = groupItemsByLine(allItems);
                    let result = null;
                    let platform = '';

                    // Identify Platform Logic
                    if (fullText.includes('TikTok Shop') || file.name.startsWith('TTSTH') || file.name.startsWith('Prod_V2') || file.name.includes('THTT') || fullText.includes('Advertising Fees')) {
                        const isCreditNote = fullText.includes('CREDIT NOTE') || fullText.includes('Credit note');
                        result = extractTikTokDataV4(lines, fullText, isCreditNote, file.name);
                        platform = result.subPlatform === 'tiktok_ads' ? 'TikTok Ads' : result.subPlatform === 'tiktok_affiliate' ? 'TikTok Aff' : 'TikTok Shop';
                    } else if (fullText.includes('Shopee') || file.name.startsWith('Shopee')) {
                        result = extractShopeeDataV4(lines, fullText, file.name);
                        platform = 'Shopee';
                    } else if (fullText.includes('Thai Happy Logistics') || file.name.startsWith('THJV')) {
                        result = extractThaiHappyDataV4(lines, fullText, file.name);
                        platform = 'TikTok Log';
                    } else {
                        return { status: 'unknown', file: file.name, data: null };
                    }

                    return { status: 'success', file: file.name, platform, data: result };

                } catch (err) {
                    console.error(`Error processing ${file.name}:`, err);
                    return { status: 'error', file: file.name, message: err.message, data: null };
                }
            }));

            batchResults.forEach(res => {
                currentStatusList.push(res);
                if (res.status === 'success' && res.data) {
                    currentBatchData.push(res.data);
                }
            });

            setFileStatusList([...currentStatusList]); 
            const newCount = Math.min((i + BATCH_SIZE), files.length);
            setProcessedCount(newCount);
            setProgress(Math.round((newCount / files.length) * 100));

            await new Promise(resolve => setTimeout(resolve, 50));
        }

        if (!abortRef.current) {
            setData(prev => {
                const existingIds = new Set(prev.map(item => item.id));
                const filteredNew = currentBatchData.filter(item => !existingIds.has(item.id));
                const combined = [...prev, ...filteredNew];
                return combined.sort((a, b) => {
                    const parseSortDate = (d) => {
                       if(!d) return 0;
                       const parts = d.split('/');
                       if(parts.length === 3) return new Date(`${parts[2]}-${parts[1]}-${parts[0]}`).getTime();
                       return 0;
                    };
                    return parseSortDate(a.date) - parseSortDate(b.date);
                });
            });
        }

    } catch (globalErr) {
        console.error("Critical Error:", globalErr);
    } finally {
        setIsProcessing(false);
    }
  };

  const filteredData = useMemo(() => {
      if (platformFilter === 'all') return data;
      // Filter logic: 'tiktok' includes shop, ads, aff, thaihappy
      if (platformFilter === 'tiktok') {
          return data.filter(item => item.platform === 'tiktok');
      }
      return data.filter(item => item.platform === platformFilter);
  }, [data, platformFilter]);

  const totals = useMemo(() => {
    return filteredData.reduce((acc, curr) => {
      acc.ads += curr.ads || 0;
      acc.comm += curr.comm || 0;
      acc.trans += curr.trans || 0;
      acc.service += curr.service || 0;
      acc.ams += curr.ams || 0;
      acc.infra += curr.infra || 0;
      acc.growth += curr.growth || 0;
      acc.affiliate += curr.affiliate || 0;
      acc.logistics += curr.logistics || 0;
      
      acc.vat += curr.vat || 0;
      acc.wht += curr.wht || 0;
      acc.total += curr.total || 0;
      return acc;
    }, { 
        ads: 0, comm: 0, trans: 0, service: 0, ams: 0, infra: 0, growth: 0, affiliate: 0, logistics: 0,
        vat: 0, wht: 0, total: 0
    });
  }, [filteredData]);

  const pieData = [
    { name: 'โฆษณา (Ads)', value: totals.ads },
    { name: 'ขนส่ง (Logistics)', value: totals.logistics },
    { name: 'คอมมิชชั่น (Comm)', value: totals.comm },
    { name: 'Affiliate', value: totals.affiliate }, // Moved up
    { name: 'ธรรมเนียม (Trans)', value: totals.trans },
    { name: 'บริการ (Service)', value: totals.service },
    { name: 'Growth Fee', value: totals.growth },
    { name: 'AMS', value: totals.ams },
    { name: 'Infra', value: totals.infra },
  ].filter(i => i.value > 0);

  const statusStats = useMemo(() => {
      return {
          success: fileStatusList.filter(f => f.status === 'success').length,
          error: fileStatusList.filter(f => f.status === 'error').length,
          unknown: fileStatusList.filter(f => f.status === 'unknown').length,
      };
  }, [fileStatusList]);

  // --- Reconciliation: Profit = Revenue - COGS - Platform Fees (incl. VAT) ---
  const reconRows = useMemo(() => {
    const map = {};

    // Aggregate platform fees (the amount actually paid to the platform) by platform + month
    filteredData.forEach(item => {
      const platform = item.platform === 'shopee' ? 'shopee' : 'tiktok';
      const month = monthOf(item.date);
      const key = `${platform}__${month}`;
      if (!map[key]) map[key] = { key, platform, month, fees: 0, wht: 0, docs: 0 };
      map[key].fees += item.total || 0;
      map[key].wht += item.wht || 0;
      map[key].docs += 1;
    });

    // Also surface any manually-entered revenue rows that have no imported fee docs yet,
    // respecting the current platform filter.
    Object.keys(revenueMap).forEach(key => {
      const [platform] = key.split('__');
      const passesFilter =
        platformFilter === 'all' ||
        (platformFilter === 'tiktok' && platform === 'tiktok') ||
        platformFilter === platform;
      if (!map[key] && passesFilter) {
        const month = key.split('__')[1];
        map[key] = { key, platform, month, fees: 0, wht: 0, docs: 0 };
      }
    });

    return Object.values(map).map(r => {
      const rev = revenueMap[r.key]?.revenue || 0;
      const cogs = revenueMap[r.key]?.cogs || 0;
      const totalCost = cogs + r.fees;
      const profit = rev - totalCost;
      const margin = rev ? (profit / rev) * 100 : 0;
      return { ...r, revenue: rev, cogs, totalCost, profit, margin };
    }).sort((a, b) => {
      const d = monthSortValue(b.month) - monthSortValue(a.month);
      if (d !== 0) return d;
      return a.platform.localeCompare(b.platform);
    });
  }, [filteredData, revenueMap, platformFilter]);

  const profitTotals = useMemo(() => {
    const t = reconRows.reduce((a, r) => {
      a.revenue += r.revenue;
      a.cogs += r.cogs;
      a.fees += r.fees;
      a.profit += r.profit;
      return a;
    }, { revenue: 0, cogs: 0, fees: 0, profit: 0 });
    t.totalCost = t.cogs + t.fees;
    t.margin = t.revenue ? (t.profit / t.revenue) * 100 : 0;
    return t;
  }, [reconRows]);

  // Monthly Revenue vs Cost vs Profit for the trend chart
  const profitChart = useMemo(() => {
    const m = {};
    reconRows.forEach(r => {
      if (!m[r.month]) m[r.month] = { month: r.month, revenue: 0, cost: 0, profit: 0 };
      m[r.month].revenue += r.revenue;
      m[r.month].cost += r.totalCost;
      m[r.month].profit += r.profit;
    });
    return Object.values(m).sort((a, b) => monthSortValue(a.month) - monthSortValue(b.month));
  }, [reconRows]);

  return (
    <div className="min-h-screen bg-slate-50 p-4 md:p-8 font-sans text-slate-900">
      <div className="max-w-7xl mx-auto space-y-6">
        
        {/* Header */}
        <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <div>
            <h1 className="text-2xl md:text-3xl font-bold text-slate-800 flex items-center gap-2">
              <span className="bg-gradient-to-r from-pink-500 to-black text-white p-2 rounded-lg"><FileText size={24} /></span>
              Profit &amp; Reconciliation <span className="text-sm font-normal text-slate-400 ml-2">v5.0</span>
            </h1>
            <p className="text-slate-500 mt-1 ml-1">Shopee | TikTok · ต้นทุน · รายได้ · กำไร · กระทบยอด</p>
          </div>
          
          <div className="flex items-center gap-3">
             <button onClick={saveData} className="flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition-colors font-medium text-sm">
                <Save size={16} /> บันทึก
            </button>
            <div className="flex bg-slate-100 p-1 rounded-lg">
              <button onClick={() => setActiveTab('overview')} className={`px-4 py-2 rounded-md text-sm font-medium transition-all flex items-center gap-2 ${activeTab === 'overview' ? 'bg-white text-blue-600 shadow-sm' : 'text-slate-500 hover:text-slate-700'}`}>
                <PieChartIcon size={16} /> ภาพรวม
              </button>
              <button onClick={() => setActiveTab('import')} className={`px-4 py-2 rounded-md text-sm font-medium transition-all flex items-center gap-2 ${activeTab === 'import' ? 'bg-white text-blue-600 shadow-sm' : 'text-slate-500 hover:text-slate-700'}`}>
                <Upload size={16} /> นำเข้าไฟล์
              </button>
              <button onClick={() => setActiveTab('profit')} className={`px-4 py-2 rounded-md text-sm font-medium transition-all flex items-center gap-2 ${activeTab === 'profit' ? 'bg-white text-blue-600 shadow-sm' : 'text-slate-500 hover:text-slate-700'}`}>
                <Scale size={16} /> กำไร/กระทบยอด
              </button>
              <button onClick={() => setActiveTab('details')} className={`px-4 py-2 rounded-md text-sm font-medium transition-all flex items-center gap-2 ${activeTab === 'details' ? 'bg-white text-blue-600 shadow-sm' : 'text-slate-500 hover:text-slate-700'}`}>
                <FileIcon size={16} /> รายละเอียด
              </button>
            </div>
          </div>
        </div>

