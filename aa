                        <th className="px-6 py-4 text-right whitespace-nowrap">Ads/Affil/Logs</th>
                        <th className="px-6 py-4 text-right whitespace-nowrap">ค่าธรรมเนียมต่างๆ</th>
                        <th className="px-6 py-4 text-right bg-slate-50 font-bold whitespace-nowrap">ยอดรวม (VAT)</th>
                        <th className="px-6 py-4 text-right text-purple-600 whitespace-nowrap">WHT</th>
                    </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-100">
                    {filteredData.length === 0 ? (
                        <tr>
                            <td colSpan={7} className="px-6 py-12 text-center text-slate-400">
                                ไม่พบข้อมูลตามเงื่อนไข
                            </td>
                        </tr>
                    ) : (
                        filteredData.map((row, idx) => (
                        <tr key={idx} className="hover:bg-slate-50 transition-colors">
                        <td className="px-6 py-4">
                            <span className={`px-2 py-1 rounded text-xs font-bold 
                                ${row.platform === 'shopee' ? 'bg-orange-100 text-orange-600' : 
                                  row.platform === 'tiktok' ? 'bg-black text-white' : 'bg-slate-100'}`}>
                                {row.platform === 'shopee' ? 'Shopee' : 'TikTok'}
                            </span>
                        </td>
                        <td className="px-6 py-4 font-medium text-slate-700 whitespace-nowrap">{row.date}</td>
                        <td className="px-6 py-4 text-slate-500 font-mono text-xs whitespace-nowrap">{row.id}</td>
                        <td className="px-6 py-4 text-right text-slate-700">
                            {row.ads > 0 && <div className="text-xs text-orange-500">Ads: {formatCurrency(row.ads)}</div>}
                            {row.affiliate > 0 && <div className="text-xs text-pink-500">Aff: {formatCurrency(row.affiliate)}</div>}
                            {row.logistics > 0 && <div className="text-xs text-green-600">Log: {formatCurrency(row.logistics)}</div>}
                            {row.ads === 0 && row.affiliate === 0 && row.logistics === 0 && '-'}
                        </td>
                        <td className="px-6 py-4 text-right text-slate-600">
                            <div className="text-xs">Comm: {formatCurrency(row.comm)}</div>
                            <div className="text-xs">Trans: {formatCurrency(row.trans)}</div>
                            {row.growth > 0 && <div className="text-xs">Growth: {formatCurrency(row.growth)}</div>}
                        </td>
                        <td className="px-6 py-4 text-right bg-slate-50 font-bold text-slate-800">{formatCurrency(row.total)}</td>
                        <td className="px-6 py-4 text-right text-purple-600 font-medium">{formatCurrency(row.wht)}</td>
                        </tr>
                    )))}
                    </tbody>
                    {filteredData.length > 0 && (
                        <tfoot className="bg-slate-100 font-bold border-t-2 border-slate-200">
                            <tr>
                                <td className="px-6 py-4" colSpan={3}>รวมทั้งหมด</td>
                                <td className="px-6 py-4 text-right text-orange-700">{formatCurrency(totals.ads + totals.affiliate + totals.logistics)}</td>
                                <td className="px-6 py-4 text-right">{formatCurrency(totals.comm + totals.trans + totals.growth + totals.service)}</td>
                                <td className="px-6 py-4 text-right bg-slate-200 text-slate-900">{formatCurrency(totals.total)}</td>
                                <td className="px-6 py-4 text-right text-purple-700">{formatCurrency(totals.wht)}</td>
                            </tr>
                        </tfoot>
                    )}
                </table>
                </div>
            </div>
            )}
          </>
        )}
      </div>
    </div>
  );
}

// --- Components ---
const Card = ({ title, value, subtext, icon: Icon, color }) => (
  <div className="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-start space-x-4 transition-transform hover:-translate-y-1 duration-200 h-full">
    <div className={`p-3 rounded-xl ${color} bg-opacity-10 shrink-0`}>
      <Icon className={`w-6 h-6 ${color.replace('bg-', 'text-')}`} />
    </div>
    <div className="min-w-0">
      <p className="text-slate-500 text-sm font-medium truncate" title={title}>{title}</p>
      <h3 className="text-xl md:text-2xl font-bold text-slate-800 mt-1">{value}</h3>
      {subtext && <p className="text-slate-400 text-xs mt-1 truncate" title={subtext}>{subtext}</p>}
    </div>
  </div>
);
