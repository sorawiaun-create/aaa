# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ถูก gitignore ไว้ ไม่ถูก commit)

# Access token ของ Facebook (System User token แนะนำ เพราะไม่หมดอายุง่าย)
FB_ACCESS_TOKEN=EAAxxxxxxxx

# ตัวเลือกเสริม
# FB_DRY_RUN=1        # 1 = จำลองอย่างเดียว ไม่แก้ไขจริง
# CONFIG_PATH=config.json
# STATE_PATH=state.json
# LOG_LEVEL=INFO      # DEBUG เพื่อดูรายละเอียดมากขึ้น
