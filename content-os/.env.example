# คัดลอกเป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ถูก gitignore ไว้)
# บน GitHub ให้ใส่เป็น Secrets แทน: Settings → Secrets and variables → Actions

# Token ของ Meta — ใช้ตัวเดียวกับ Facebook Ads Automation ได้เลย
# แนะนำ System User token (ไม่หมดอายุง่าย)
# สิทธิ์ที่ต้องมี: ads_read, instagram_basic, instagram_manage_insights, pages_read_engagement
FB_ACCESS_TOKEN=EAAxxxxxxxx

# บัญชีโฆษณา — ไม่ใส่ = ข้ามหน้า ADS (ใช้ข้อมูลตัวอย่างแทน)
# หาได้จาก Meta Ads Manager บนแถบ URL: act_1234567890
FB_AD_ACCOUNT_ID=1234567890

# Instagram Business/Creator account id — ไม่ใส่ = ข้ามหน้า ANALYTICS
# หาได้จาก: GET /me/accounts → เลือกเพจ → GET /{page-id}?fields=instagram_business_account
IG_USER_ID=17841400000000000

# ตัวเลือกเสริม
# GRAPH_API_VERSION=v21.0
# OUT_PATH=content-os/data.json
# LOG_LEVEL=INFO
